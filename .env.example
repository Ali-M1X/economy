# Copy to .env for local/VPS runs (never commit .env). In GitHub Actions set these as repository Secrets instead.
# Only FRED_API_KEY is needed to collect data; the rest switch features on.

# FRED (free): https://fredaccount.stlouisfed.org/apikeys — enables ALFRED vintages, metadata and release dates.
# Without it, collectors fall back to keyless fredgraph.csv downloads (latest values only).
FRED_API_KEY=

# Optional (free): raises BLS API limits — https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Telegram (Phase 6): bot token from @BotFather, chat id of your channel/group/user
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude (news/Fed classification + written explanation); model is configurable
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Link at the end of every Telegram message
DASHBOARD_URL=

# Database (optional; the system works from snapshots without it).
# Supabase Postgres connection string (Project Settings → Database → Connection string → URI, "Session pooler").
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (URL-encode @ : / # in the password). If empty, a local SQLite file (data/macro_pulse.sqlite) is used.
DATABASE_URL=
# Writing to the database also requires this switch:
ENABLE_DB_STORAGE=false

# Supabase REST (dashboard reads with the anon key; RLS allows read-only access — see db/migrations/002_security.sql)
SUPABASE_URL=
SUPABASE_KEY=

HTTP_TIMEOUT=30
